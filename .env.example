# ==============================================================================
# SECURE FILE TRANSFER MONITORING SYSTEM - ENVIRONMENT TEMPLATE
# Copy this file to .env and configure values before starting the application
# DO NOT commit the actual .env file to version control
# ==============================================================================

# Application Meta
PROJECT_NAME="Secure File Transfer Monitoring System"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Security & Authentication
# Generate a production key using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-very-long-and-cryptographically-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Default: Local SQLite database for immediate zero-config development
DATABASE_URL=sqlite:///./secure_transfer.db
# Production PostgreSQL connection string (uncomment when using Docker/Postgres):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_transfer_db

# Storage Directories (Relative or Absolute paths)
STORAGE_DIR=backend/storage/uploads
QUARANTINE_DIR=backend/storage/quarantine
REPORTS_DIR=backend/storage/reports

# File Transfer Restrictions
MAX_UPLOAD_SIZE_MB=100
ALLOWED_EXTENSIONS=pdf,docx,xlsx,txt,zip,tar,gz,csv,png,jpg,jpeg,json,xml

# Security Rule Engine Thresholds
RULE_LARGE_FILE_MB=50
RULE_WORK_HOURS_START=9
RULE_WORK_HOURS_END=18
RULE_EXCESSIVE_TRANSFERS_COUNT=10
RULE_EXCESSIVE_WINDOW_MINUTES=10
RULE_FAILED_ATTEMPTS_THRESHOLD=3

# Threat Intelligence (Optional - Leave blank for simulated reputation mode)
ABUSEIPDB_API_KEY=

# CORS Origins (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
